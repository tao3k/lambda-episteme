{
  "Healthcare": {
    "entityTypes": {
      "Provider": {},
      "Patient": {},
      "Encounter": {},
      "MedicationOrder": {
        "shape": {
          "type": "Record",
          "attributes": {
            "assignedProvider": { "type": "Entity", "name": "Provider" },
            "patient": { "type": "Entity", "name": "Patient" },
            "encounter": { "type": "Entity", "name": "Encounter" },
            "reconciliationObserved": { "type": "Boolean" },
            "revoked": { "type": "Boolean" }
          }
        }
      }
    },
    "actions": {
      "administerMedication": {
        "appliesTo": {
          "principalTypes": ["Provider"],
          "resourceTypes": ["MedicationOrder"],
          "context": {
            "type": "Record",
            "attributes": {
              "assuranceDigest": { "type": "String" },
              "assuranceClosed": { "type": "Boolean" },
              "trajectoryAssessmentDigest": { "type": "String" },
              "trajectoryHandoffReady": { "type": "Boolean" }
            }
          }
        }
      }
    }
  }
}
