;;; Copy all five role files; replace example and ExampleProfile.
(import :poo-flow/src/module-system/declaration/interface
        :lambda-episteme/modules/example/funs)
(export example-config)
(def (example-config selection)
  (unless (and (poo-flow-user-module-selection? selection)
               (equal? (poo-flow-user-module-selection-key selection) '(custom . example))
               (null? (poo-flow-user-module-selection-flags selection)))
    (error "invalid example module selection"))
  example-module)
