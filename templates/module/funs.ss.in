;;; Copy all five role files; replace example and ExampleProfile.
(import :poo-flow/lambda-episteme/governance/objects
        :poo-flow/lambda-episteme/modules/example/types
        :poo-flow/lambda-episteme/modules/example/objects)
(export example-contribution example-module)
(def (example-contribution profile)
  (unless (example-profile? profile) (error "invalid example profile"))
  (governance-module profile))
(def example-module (example-contribution ExampleProfile))
